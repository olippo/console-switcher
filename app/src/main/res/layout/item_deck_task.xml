<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/deck_card_bg"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <FrameLayout
            android:id="@+id/cardInnerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_task_card_normal">

                <!-- App Preview - 16:9 aspect ratio -->
                <ImageView
                    android:id="@+id/ivTaskPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#0A0F1A"
                    android:contentDescription="Task Snapshot Preview" />

                <!-- Current task resume arrow: shown instead of preview when app is currently open -->
                <ImageView
                    android:id="@+id/ivCurrentTaskArrow"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_keyboard_arrow_up_rounded"
                    app:tint="@color/deck_text_primary"
                    android:visibility="gone"
                    android:contentDescription="Currently open task" />

                <!-- Border overlay drawn ON TOP of the preview so the stroke is
                     never hidden behind an opaque snapshot. -->
                <View
                    android:id="@+id/vBorder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- App identity under the card: separate from the card itself, 16dp gap,
         centered under the card. INVISIBLE (not gone) when not
         selected so every item keeps the same height and showing/hiding the
         label never triggers a re-layout mid-scroll (which flickers). -->
    <LinearLayout
        android:id="@+id/labelRow"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center|center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="App icon"
            tools:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center|center_vertical"
            android:maxLines="1"
            android:textColor="@color/deck_text_primary"
            android:textSize="16sp"
            tools:text="App title" />

    </LinearLayout>
</LinearLayout>
